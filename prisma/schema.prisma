generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  password            String
  createdAt           DateTime             @default(now())
  maxProducts         Int                  @default(5)
  plan                String               @default("free")
  role                String               @default("reseller")
  financeTransactions FinanceTransaction[]
  integrations        Integration[]
  orders              Order[]
  products            Product[]
  resellerProducts    ResellerProduct[]
}

model Supplier {
  id          String                     @id @default(cuid())
  companyName String
  email       String                     @unique
  phone       String?
  createdAt   DateTime                   @default(now())
  imports     MarketplaceImportHistory[]
  products    MarketplaceProduct[]
}

model MarketplaceProduct {
  id               String            @id @default(cuid())
  title            String
  description      String?
  costPrice        Float
  suggestedPrice   Float
  image            String?
  stock            Int               @default(0)
  supplierId       String
  createdAt        DateTime          @default(now())
  brand            String?           @default("Sem Marca")
  categoryId       String?
  categoryName     String?
  ean              String?
  listingType      String?           @default("gold_special")
  sku              String?
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  resellerProducts ResellerProduct[]

  @@index([supplierId])
  @@index([supplierId, sku])
}

model MarketplaceImportHistory {
  id         String   @id @default(cuid())
  supplierId String
  fileName   String
  total      Int
  imported   Int
  duplicates Int
  errors     Int
  duration   Int
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([createdAt])
}

model ResellerProduct {
  id                   String             @id @default(cuid())
  resellerId           String
  marketplaceProductId String
  customPrice          Float?
  active               Boolean            @default(true)
  createdAt            DateTime           @default(now())
  publishedProducts    Product[]
  marketplaceProduct   MarketplaceProduct @relation(fields: [marketplaceProductId], references: [id])
  reseller             User               @relation(fields: [resellerId], references: [id])

  @@index([resellerId])
  @@index([marketplaceProductId])
}

model Product {
  id                String           @id @default(cuid())
  title             String
  price             Float
  category          String           @default("Mercado Livre")
  image             String?
  createdAt         DateTime         @default(now())
  userId            String
  marketplace       String           @default("mercadolivre")
  marketplaceId     String?          @unique
  permalink         String?
  status            String?
  stock             Int              @default(0)
  description       String?
  mlCategoryId      String?
  resellerProductId String?
  brand             String?
  costPrice         Float?
  ean               String?
  height            Float?
  length            Float?
  model             String?
  shortDescription  String?
  sku               String?
  weight            Float?
  width             Float?
  orders            Order[]
  resellerProduct   ResellerProduct? @relation(fields: [resellerProductId], references: [id])
  user              User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Order {
  id                  String               @id @default(cuid())
  productId           String
  sellerId            String
  amount              Float
  status              String               @default("pending")
  paymentId           String?
  externalReference   String?
  customerEmail       String?
  createdAt           DateTime             @default(now())
  buyerName           String?
  externalOrderId     String?
  marketplace         String               @default("mercadolivre")
  quantity            Int                  @default(1)
  shippingStatus      String?
  financeTransactions FinanceTransaction[] @relation("OrderTransactions")
  product             Product              @relation(fields: [productId], references: [id])
  seller              User                 @relation(fields: [sellerId], references: [id])

  @@unique([externalOrderId, marketplace])
  @@index([sellerId])
  @@index([productId])
  @@index([createdAt])
  @@index([status])
}

model Integration {
  id                   String    @id @default(cuid())
  provider             String
  accessToken          String?
  refreshToken         String?
  externalUserId       String?
  userId               String
  createdAt            DateTime  @default(now())
  accessTokenExpiresAt DateTime?
  user                 User      @relation(fields: [userId], references: [id])

  @@unique([provider, userId])
  @@index([userId])
}

model FinanceTransaction {
  id            String    @id @default(cuid())
  userId        String
  orderId       String?
  type          String
  category      String
  description   String?
  amount        Float
  createdAt     DateTime  @default(now())
  dueDate       DateTime?
  isRecurring   Boolean   @default(false)
  notes         String?
  paymentDate   DateTime?
  paymentMethod String?
  recurrence    String?
  reference     String?
  status        String    @default("pending")
  order         Order?    @relation("OrderTransactions", fields: [orderId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([dueDate])
}

model SystemLog {
  id        String   @id @default(cuid())
  service   String
  event     String
  status    String
  message   String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([service])
  @@index([status])
  @@index([createdAt])
}
