generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  password         String
  createdAt        DateTime          @default(now())
  maxProducts      Int               @default(5)
  plan             String            @default("free")
  role             String            @default("reseller")
  integrations     Integration[]
  orders           Order[]
  products         Product[]
  resellerProducts ResellerProduct[]
}

model Supplier {
  id          String               @id @default(cuid())
  companyName String
  email       String               @unique
  phone       String?
  createdAt   DateTime             @default(now())
  products    MarketplaceProduct[]
}

model MarketplaceProduct {
  id               String            @id @default(cuid())
  title            String
  description      String?
  costPrice        Float
  suggestedPrice   Float
  image            String?
  stock            Int               @default(0)
  supplierId       String
  createdAt        DateTime          @default(now())
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  resellerProducts ResellerProduct[]
}

model ResellerProduct {
  id                   String             @id @default(cuid())
  resellerId           String
  marketplaceProductId String
  customPrice          Float?
  active               Boolean            @default(true)
  createdAt            DateTime           @default(now())
  marketplaceProduct   MarketplaceProduct @relation(fields: [marketplaceProductId], references: [id])
  reseller             User               @relation(fields: [resellerId], references: [id])
}

model Product {
  id            String   @id @default(cuid())
  title         String
  price         Float
  category      String   @default("Mercado Livre")
  image         String?
  createdAt     DateTime @default(now())
  userId        String
  marketplace   String   @default("mercadolivre")
  marketplaceId String?  @unique
  permalink     String?
  status        String?
  stock         Int      @default(0)
  description   String?
  mlCategoryId  String?
  orders        Order[]
  user          User     @relation(fields: [userId], references: [id])
}

model Order {
  id                String   @id @default(cuid())
  productId         String
  sellerId          String
  amount            Float
  status            String   @default("pending")
  paymentId         String?
  externalReference String?
  customerEmail     String?
  createdAt         DateTime @default(now())
  product           Product  @relation(fields: [productId], references: [id])
  seller            User     @relation(fields: [sellerId], references: [id])
}

model Integration {
  id             String   @id @default(cuid())
  provider       String
  accessToken    String?
  refreshToken   String?
  externalUserId String?
  userId         String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@unique([provider, userId])
}
